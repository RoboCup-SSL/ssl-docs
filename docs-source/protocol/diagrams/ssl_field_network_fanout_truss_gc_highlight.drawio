                    <mxGeometry x="778" y="78" width="30" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="switch" value="Field-Side Switch&lt;br&gt;24-port&lt;br&gt;PoE &amp;middot; IGMP snooping&lt;br&gt;VLAN &amp;middot; &lt;i&gt;10&lt;/i&gt; (example — event-assigned)&lt;br&gt;Mgmt IP: &lt;i&gt;10.10.0.2&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=12;align=center;verticalAlign=middle;fontColor=#1E3A8A;spacing=6;strokeWidth=3;" parent="1" vertex="1">
